# ----------------------------------------------------------------------------
# q-engine environment variables.
# Copy this file to `.env` for local development or to `.env.production`
# for the deployed stack.
# ----------------------------------------------------------------------------

# ---- Database ---------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=qcraft

# ---- App --------------------------------------------------------------------
PORT=3000
NODE_ENV=development

# CORS — comma-separated origins. Use * only in dev.
# Example for prod: CORS_ORIGINS=https://qcraft.example.com
CORS_ORIGINS=*

# Rate limiting (NestJS Throttler)
THROTTLE_TTL=60       # seconds
THROTTLE_LIMIT=120    # requests per TTL per IP

# ---- Uploads ----------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25

# ---- LLM --------------------------------------------------------------------
# Local development with LM Studio:
#   LLM_BASE_URL=http://localhost:1234/v1
#   LLM_MODEL=                       # blank = use whichever model LM Studio has loaded
#
# Production with Ollama (running in the same docker network):
#   LLM_BASE_URL=http://ollama:11434/v1
#   LLM_MODEL=llama3.1:8b
#
# Hosted OpenAI-compatible API:
#   LLM_BASE_URL=https://api.openai.com/v1
#   LLM_API_KEY=sk-...
#   LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=not-needed
LLM_MODEL=
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=2

# ---- TypeORM migrations -----------------------------------------------------
# When unset / "false" we run migrations on boot. Set to "true" only for
# brand-new local dev databases — never in production.
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=true
