# ---------------------------------------------------------------------------
# Production env file. Copy to .env.production and edit before running:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# Never commit .env.production.
# ---------------------------------------------------------------------------

# ---- Domain + TLS -----------------------------------------------------------
DOMAIN=your-domain.com
LETSENCRYPT_EMAIL=you@your-domain.com

# ---- Database --------------------------------------------------------------
DB_USER=qcraft
DB_PASSWORD=replace-with-a-strong-password
DB_NAME=qcraft

# ---- API / CORS ------------------------------------------------------------
# Comma-separated list. Drop the * — set the real frontend origins only.
CORS_ORIGINS=https://your-domain.com

# ---- LLM (Ollama in-network) -----------------------------------------------
LLM_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=2

# ---- Uploads / throttling --------------------------------------------------
MAX_UPLOAD_MB=25
THROTTLE_TTL=60
THROTTLE_LIMIT=120
