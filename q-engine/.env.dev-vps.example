# ---------------------------------------------------------------------------
# Env file for the dev-on-VPS stack.
# Copy to .env.dev-vps on the VPS and edit. NEVER commit it.
# ---------------------------------------------------------------------------

# ---- Database --------------------------------------------------------------
DB_USER=qcraft
DB_PASSWORD=replace-me-with-a-random-password
DB_NAME=qcraft

# ---- LLM (Ollama in-network) -----------------------------------------------
# llama3.2:3b is a sensible default for 8 GB VPSes (≈2 GB on disk, ≈3 GB RAM).
# Bump to llama3.1:8b if the VPS has 16 GB+ RAM.
LLM_MODEL=llama3.2:3b
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=2

# ---- Other -----------------------------------------------------------------
MAX_UPLOAD_MB=25
THROTTLE_TTL=60
THROTTLE_LIMIT=1000
