# ---------------------------------------------------------------------------
# Env for the home-server deployment (qcraft.code-etp.name.ng).
# Copy to .env.home, fill in DB_PASSWORD, never commit.
# ---------------------------------------------------------------------------

DOMAIN=qcraft.code-etp.name.ng
LETSENCRYPT_EMAIL=lateef.olawole@vigourtech.org

DB_USER=qcraft
DB_PASSWORD=replace-me
DB_NAME=qcraft

CORS_ORIGINS=*

# Host's native Ollama already has this model pulled.
LLM_MODEL=llama3.1:8b
LLM_TEMPERATURE=0.4
LLM_TIMEOUT_MS=120000
LLM_MAX_RETRIES=2

MAX_UPLOAD_MB=25
THROTTLE_TTL=60
THROTTLE_LIMIT=1000
